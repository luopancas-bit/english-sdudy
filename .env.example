NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DATABASE_URL=file:./data/english-study.sqlite
CONTENT_DIR=./content-private
RECORDINGS_DIR=./recordings
SESSION_COOKIE_NAME=zhuguang_session
# Keep true behind HTTPS. Set false only for a temporary trusted-LAN HTTP test.
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
# Generate a long random value for production. Never commit the real value.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Used only once to create the first administrator.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-run
